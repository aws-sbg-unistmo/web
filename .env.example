# Variables públicas que usa la página al compilar (en producción las pone GitHub Actions).
# URL base de la API de formularios (salida ApiUrl del stack de AWS). Vacía = los formularios abren el correo.
PUBLIC_API_URL=
# Llave pública (site key) de Cloudflare Turnstile. Vacía = llave de pruebas que siempre aprueba.
PUBLIC_TURNSTILE_SITE_KEY=
