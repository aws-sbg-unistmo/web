{
  "kind": "collectionType",
  "collectionName": "eventos",
  "info": {
    "singularName": "evento",
    "pluralName": "eventos",
    "displayName": "Evento",
    "description": "Talleres, charlas y encuentros. Al publicarlos aparecen en la página."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "inicio": {
      "type": "datetime",
      "required": true
    },
    "fin": {
      "type": "datetime"
    },
    "lugar": {
      "type": "string",
      "maxLength": 140
    },
    "descripcion": {
      "type": "text",
      "maxLength": 2000
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "enlace": {
      "type": "string",
      "regex": "^https://"
    }
  }
}
