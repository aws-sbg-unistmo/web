{
  "kind": "collectionType",
  "collectionName": "alianzas",
  "info": {
    "singularName": "alianza",
    "pluralName": "alianzas",
    "displayName": "Alianza",
    "description": "Comunidades, empresas e instituciones aliadas."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "Comunidad",
        "Empresa",
        "Institucion",
        "Medio"
      ],
      "default": "Comunidad",
      "required": true
    },
    "lema": {
      "type": "string",
      "maxLength": 80
    },
    "texto": {
      "type": "text",
      "required": true,
      "maxLength": 400
    },
    "url": {
      "type": "string",
      "regex": "^https://"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "redes": {
      "type": "component",
      "repeatable": true,
      "component": "equipo.red"
    },
    "orden": {
      "type": "integer",
      "default": 10
    }
  }
}
