---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
// Las dos fuentes se precargan para que el texto no "salte" cuando terminan de llegar (CLS)
import fuenteTexto from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import fuenteTitulos from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Imagen principal de la página: se descarga primero para que se vea cuanto antes */
  precargar?: string;
}
const { titulo, descripcion = site.descripcion, precargar } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.corto}` : `${site.corto} · ${site.lema}`;
// En las páginas con formulario el botón fijo de celular taparía el botón de enviar
// Base pública del sitio (con diagonal final), respetando subcarpetas como /web/ en la vista previa
const base = Astro.site ? new URL(Astro.site.href.replace(/\/?$/, '/')) : null;
const canonica = base ? new URL(Astro.url.pathname.replace(/^\//, ''), base).href : null;
const imagenSocial = new URL('img/og.jpg', base ?? Astro.url).href;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#161D26" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/logo-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/logo-192.png" />
    {canonica && <link rel="canonical" href={canonica} />}
    {canonica && <meta property="og:url" content={canonica} />}
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenSocial} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={fuenteTitulos} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fuenteTexto} crossorigin />
    {precargar && <link rel="preload" as="image" href={precargar} fetchpriority="high" media="(min-width: 768px)" />}
  </head>
  <body class="min-h-dvh overflow-x-clip font-sans antialiased selection:bg-magenta selection:text-marino">
    <!-- Barra de progreso de lectura y luz que sigue al cursor -->
    <div id="progreso" aria-hidden="true" class="fixed inset-x-0 top-0 z-[60] h-0.5 origin-left scale-x-0 bg-gradient-to-r from-magenta via-morado to-azul"></div>
    <div id="foco" aria-hidden="true" class="pointer-events-none fixed inset-0 z-30 hidden md:block"></div>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-magenta focus:px-4 focus:py-2 focus:text-marino">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="overflow-x-clip">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/animaciones';
      import '../scripts/carrusel';
    </script>
  </body>
</html>

<style is:global>
  #foco {
    background: radial-gradient(600px circle at var(--mx, 50%) var(--my, -20%), color-mix(in srgb, var(--color-magenta) 7%, transparent), transparent 60%);
  }
</style>
