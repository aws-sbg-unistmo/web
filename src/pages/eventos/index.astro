---
import PapelPicado from '../../components/PapelPicado.astro';
import Layout from '../../layouts/Layout.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import EventoTarjeta from '../../components/EventoTarjeta.astro';
import Icono from '../../components/Icono.astro';
import Palabras from '../../components/Palabras.astro';
import Preguntas from '../../components/Preguntas.astro';
import { pasados, proximos } from '../../lib/eventos';
import { site } from '../../data/site';

const tipos = [
  { icono: 'taller', titulo: 'Talleres prácticos', texto: 'Dos horas con tu laptop construyendo algo real en la consola de AWS.', color: 'var(--color-magenta)' },
  { icono: 'usuarios', titulo: 'Charlas con la industria', texto: 'Profesionales de AWS y de la comunidad tech cuentan cómo trabajan.', color: 'var(--color-morado)' },
  { icono: 'certificado', titulo: 'Study jams', texto: 'Sesiones en grupo para preparar tu primera certificación de AWS.', color: 'var(--color-azul)' },
  { icono: 'rayo', titulo: 'Build days', texto: 'Retos en equipo para crear un proyecto completo en un solo día.', color: 'var(--color-menta)' },
] as const;

const pasos = [
  { icono: 'microfono', t: 'Lo publicamos', d: 'Cada evento sale primero en Meetup y en nuestras redes, con fecha, lugar y temario.' },
  { icono: 'check', t: 'Te registras', d: 'Marca que asistes (RSVP) en Meetup para apartar tu lugar. Te llegan recordatorios.' },
  { icono: 'laptop', t: 'Llegas y construyes', d: 'Presentamos el tema y luego manos a la obra, con ayuda del equipo en todo momento.' },
  { icono: 'libro', t: 'Te llevas el material', d: 'Compartimos las guías para que repitas el ejercicio en casa y sigas avanzando.' },
];
// Qué llevar a un taller: cada cosa con su ilustración (public/img/llevar) y su color
const llevar = [
  { img: 'laptop', t: 'Tu laptop y su cargador', d: 'Cualquier sistema operativo funciona.', c: 'var(--color-magenta)', w: 300, h: 300 },
  { img: 'navegador', t: 'Un navegador actualizado', d: 'Chrome, Edge o Firefox: todo es desde la web.', c: 'var(--color-azul)', w: 300, h: 300 },
  { img: 'correo', t: 'Acceso a tu correo', d: 'Por si hay que confirmar algo en el taller.', c: 'var(--color-morado)', w: 300, h: 300 },
  { img: 'curiosidad', t: 'Curiosidad', d: 'No necesitas experiencia: te explicamos desde cero.', c: 'var(--color-naranja)', w: 300, h: 300 },
];
const preguntas = [
  { p: '¿Cuánto cuestan los eventos?', r: 'Nada. Todos los eventos del grupo son gratuitos.' },
  { p: '¿Tengo que registrarme?', r: 'Sí, en Meetup. Así apartas tu lugar, sabemos cuántas personas van y te llegan los avisos si algo cambia.' },
  { p: '¿Necesito llevar laptop?', r: 'Para los talleres, sí, porque vas a construir algo. Para las charlas no hace falta. Cada evento lo indica en su descripción.' },
  { p: '¿Necesito una cuenta de AWS?', r: 'Depende del taller. Si hace falta, lo decimos en la descripción del evento con tiempo y te explicamos cómo prepararla y cómo evitar cobros.' },
  { p: '¿Puedo ir si soy de otro campus o de otra escuela?', r: 'Los eventos están pensados para la comunidad de la UNISTMO. Cuando un evento es abierto a más personas, lo indicamos en Meetup.' },
  { p: '¿Y si ya no puedo ir?', r: 'Quita tu RSVP en Meetup para liberar tu lugar y que alguien más lo aproveche.' },
];
---
<Layout titulo="Eventos" precargar="/img/cabecera-eventos.jpg" descripcion="Talleres, charlas y eventos de AWS SBG UNISTMO en el Campus Tehuantepec.">
  <CabeceraPagina
    migas="Eventos"
    etiqueta="// Eventos"
    titulo="Talleres, charlas y mucho cloud"
    resaltar={['cloud']}
    descripcion="Todos nuestros eventos se publican en Meetup y aparecen aquí automáticamente. Regístrate ahí para apartar tu lugar."
    pose="12-audifonos"
    video="eventos"
  />
  <PapelPicado class="mx-auto mb-14 mt-2 max-w-7xl md:mb-20" />

  <section class="mx-auto max-w-7xl px-5">
    <h2 class="titulo text-2xl font-semibold" data-reveal>Próximos</h2>
    {proximos.length > 0 ? (
      <div class="mt-8 grid gap-6 lg:grid-cols-2" data-stagger>
        {proximos.map((e) => <EventoTarjeta evento={e} />)}
      </div>
    ) : (
      <div class="tarjeta mt-8 p-8" data-reveal>
        <p class="leading-relaxed">
          Todavía no hay eventos publicados. Síguenos en Meetup para recibir el aviso en cuanto abramos el registro.
        </p>
        <a href={site.meetup} target="_blank" rel="noopener" class="boton boton-primario mt-6" data-magnetico>
          Ir al Meetup <Icono nombre="externo" class="size-4" />
        </a>
      </div>
    )}

    <h2 class="titulo mt-20 text-2xl font-semibold" data-reveal>Lo que organizamos</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {tipos.map((t) => (
        <article class="tarjeta p-6" data-tilt style={`--acento:${t.color}`}>
          <span class="grid size-11 place-items-center rounded-xl" style="background:color-mix(in srgb,var(--acento) 15%,transparent);color:var(--acento)">
            <Icono nombre={t.icono} class="size-5" />
          </span>
          <h3 class="titulo mt-5 text-lg font-semibold">{t.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed">{t.texto}</p>
        </article>
      ))}
    </div>

    <h2 class="titulo mt-20 text-2xl font-semibold" data-reveal>Cómo funcionan</h2>
    <ol class="pasos relative mt-10 grid gap-8 lg:grid-cols-4 lg:gap-6" data-en-vista>
      <span class="pasos-riel" aria-hidden="true"><span class="pasos-avance"></span></span>
      {pasos.map((p, i) => (
        <li class="paso relative pl-16 lg:pl-0" style={`--i:${i}`}>
          <span class="paso-nodo titulo absolute left-0 top-0 grid size-12 place-items-center rounded-full font-bold lg:relative">
            <Icono nombre={p.icono} class="size-5" />
            <span class="paso-num absolute -right-1 -top-1 grid size-5 place-items-center rounded-full text-[0.65rem]">{i + 1}</span>
          </span>
          <div class="paso-tarjeta tarjeta p-6 lg:mt-6">
            <h3 class="titulo text-lg font-semibold">{p.t}</h3>
            <p class="mt-2 text-sm leading-relaxed">{p.d}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- Qué llevar: lista para palomear -->
    <div class="mochila mt-20 grid items-center gap-10 lg:grid-cols-[auto_1fr]" data-mochila>
      {site.usarMascota && (
        <div class="relative mx-auto hidden lg:block" data-reveal>
          <span class="globo-mochila absolute -top-4 left-1/2 z-10 w-max -translate-x-1/2 rounded-2xl border border-linea bg-marino-2 px-4 py-2 text-sm font-semibold text-white">
            <span class="texto-falta">¿Ya tienes todo?</span><span class="texto-listo hidden">¡Listo para el taller!</span>
          </span>
          <img src="/img/mascota/18-mochila.webp" alt="" width="569" height="900" loading="lazy" class="jaguar-mochila mt-10 h-72 w-auto" />
        </div>
      )}
      <div>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="titulo text-2xl font-semibold" data-reveal>Qué llevar a un taller</h2>
          <p class="font-mono text-xs text-suave/70" aria-live="polite"><span data-listos>0</span>/{llevar.length} listos · toca para palomear</p>
        </div>
        <ul class="llevar mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4" data-en-vista>
          {llevar.map((l, i) => (
            <li style={`--c:${l.c};--i:${i}`}>
              <button type="button" class="cosa tarjeta group relative flex h-full w-full flex-col items-center overflow-hidden p-4 text-center md:p-5" aria-pressed="false" data-cosa>
                <span class="cosa-luz pointer-events-none absolute left-1/2 top-6 size-32 -translate-x-1/2 rounded-full blur-3xl" aria-hidden="true"></span>
                <img src={`/img/llevar/${l.img}.webp`} alt="" width={l.w} height={l.h} loading="lazy" class="cosa-img relative h-24 w-auto md:h-28" />
                <span class="titulo relative mt-3 text-sm font-semibold text-white md:text-base">{l.t}</span>
                <span class="relative mt-1 text-xs leading-relaxed">{l.d}</span>
                <span class="cosa-check absolute right-3 top-3 grid size-7 place-items-center rounded-full" aria-hidden="true"><Icono nombre="check" class="size-4" /></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {pasados.length > 0 && (
      <>
        <h2 class="titulo mt-20 text-2xl font-semibold" data-reveal>Anteriores</h2>
        <div class="mt-8 grid gap-6 lg:grid-cols-2" data-stagger>
          {pasados.map((e) => <EventoTarjeta evento={e} pasado />)}
        </div>
      </>
    )}
  </section>

  <section class="mx-auto mt-28 max-w-4xl px-5">
    <div class="text-center">
      <p class="chip" data-reveal>// Preguntas sobre eventos</p>
      <Palabras texto="Antes de tu primer evento" resaltar={['primer']} class="mt-5 text-4xl font-bold md:text-5xl" />
    </div>
    <div class="mt-12">
      <Preguntas preguntas={preguntas} />
    </div>
  </section>
</Layout>

<style>
  /* Cómo funcionan: línea de tiempo que se dibuja y enciende cada paso en orden */
  .pasos-riel { position: absolute; left: 23px; top: 24px; bottom: 24px; width: 2px; background: var(--color-linea); }
  .pasos-avance { position: absolute; inset: 0; background: linear-gradient(180deg, var(--color-magenta), var(--color-morado), var(--color-azul)); transform-origin: top; transform: scaleY(0); }
  @media (min-width: 1024px) {
    .pasos-riel { left: 24px; right: 24px; top: 23px; bottom: auto; width: auto; height: 2px; }
    .pasos-avance { background: linear-gradient(90deg, var(--color-magenta), var(--color-morado), var(--color-azul)); transform-origin: left; transform: scaleX(0); }
  }
  .pasos:not(.preparado) .pasos-avance { transform: none; }
  .paso-nodo { background: var(--color-marino); color: var(--color-suave); box-shadow: inset 0 0 0 2px var(--color-linea); z-index: 1; }
  .paso-num { background: var(--color-linea); color: #fff; }
  .paso-tarjeta { transition: border-color 0.4s ease, translate 0.4s ease; }
  .paso:hover .paso-tarjeta { border-color: color-mix(in srgb, var(--color-magenta) 50%, transparent); translate: 0 -3px; }
  .pasos.en-vista .pasos-avance { animation: dibuja-y 1.6s cubic-bezier(0.6, 0, 0.2, 1) 0.2s both; }
  @media (min-width: 1024px) { .pasos.en-vista .pasos-avance { animation-name: dibuja-x; } }
  .pasos.en-vista .paso-nodo { animation: enciende 0.6s ease both; animation-delay: calc(0.3s + var(--i) * 0.38s); }
  .pasos.en-vista .paso-num { animation: enciende-num 0.6s ease both; animation-delay: calc(0.3s + var(--i) * 0.38s); }
  .pasos.preparado:not(.en-vista) .paso-tarjeta { opacity: 0; }
  .pasos.en-vista .paso-tarjeta { animation: sube-paso 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(0.4s + var(--i) * 0.38s); }
  @keyframes dibuja-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes dibuja-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes enciende {
    50% { box-shadow: inset 0 0 0 2px var(--color-magenta), 0 0 0 10px color-mix(in srgb, var(--color-magenta) 25%, transparent); }
    100% { color: #fff; background: color-mix(in srgb, var(--color-magenta) 22%, var(--color-marino)); box-shadow: inset 0 0 0 2px var(--color-magenta), 0 0 24px -4px var(--color-magenta); }
  }
  @keyframes enciende-num { to { background: var(--color-magenta); color: var(--color-marino); } }
  @keyframes sube-paso { from { opacity: 0; transform: translateY(24px); } }
</style>

<style>
  /* Qué llevar: cada cosa flota, se ilumina con su color y se palomea al tocarla */
  .cosa { cursor: pointer; transition: border-color 0.35s ease, translate 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .cosa:hover { border-color: color-mix(in srgb, var(--c) 55%, transparent); translate: 0 -5px; }
  .cosa-luz { background: var(--c); opacity: 0.18; transition: opacity 0.4s ease; }
  .cosa:hover .cosa-luz, .cosa[aria-pressed='true'] .cosa-luz { opacity: 0.38; }
  .cosa-img { filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.45)); animation: flota-cosa 4s ease-in-out infinite; animation-delay: calc(var(--i) * -1s); transition: scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .cosa:hover .cosa-img { scale: 1.1; }
  @keyframes flota-cosa { 50% { translate: 0 -6px; rotate: -2deg; } }
  .cosa-check { color: transparent; box-shadow: inset 0 0 0 2px var(--color-linea); transition: background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease, scale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .cosa[aria-pressed='true'] { border-color: color-mix(in srgb, var(--c) 70%, transparent); }
  .cosa[aria-pressed='true'] .cosa-check { background: var(--c); color: var(--color-marino); box-shadow: 0 0 16px var(--c); scale: 1.15; }
  .llevar.preparado:not(.en-vista) li { opacity: 0; }
  .llevar.en-vista li { animation: entra-cosa 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(var(--i) * 0.12s); }
  @keyframes entra-cosa { from { opacity: 0; transform: translateY(30px) scale(0.92); } }
  .globo-mochila { box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.6); }
  .globo-mochila::after { content: ''; position: absolute; left: 50%; bottom: -7px; width: 12px; height: 12px; translate: -50% 0; rotate: 45deg; background: var(--color-marino-2); border-right: 1px solid var(--color-linea); border-bottom: 1px solid var(--color-linea); }
  .mochila.completa .texto-falta { display: none; }
  .mochila.completa .texto-listo { display: inline; color: var(--color-menta); }
  .mochila.completa .jaguar-mochila { animation: brinco 0.7s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes brinco { 40% { translate: 0 -18px; rotate: -4deg; } }
  @media (prefers-reduced-motion: reduce) { .cosa-img { animation: none; } }
</style>

<script>
  // Palomear lo que ya tienes para el taller
  const mochila = document.querySelector<HTMLElement>('[data-mochila]');
  const cosas = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cosa]'));
  const listos = document.querySelector('[data-listos]');
  cosas.forEach((c) => c.addEventListener('click', () => {
    c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
    const n = cosas.filter((x) => x.getAttribute('aria-pressed') === 'true').length;
    if (listos) listos.textContent = String(n);
    mochila?.classList.toggle('completa', n === cosas.length);
  }));
</script>
