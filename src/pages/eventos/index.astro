---
import Layout from '../../layouts/Layout.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import EventoTarjeta from '../../components/EventoTarjeta.astro';
import Icono from '../../components/Icono.astro';
import { pasados, proximos } from '../../lib/eventos';
import { site } from '../../data/site';

const tipos = [
  { icono: 'taller', titulo: 'Talleres prácticos', texto: 'Dos horas con tu laptop construyendo algo real en la consola de AWS.', color: 'var(--color-magenta)' },
  { icono: 'usuarios', titulo: 'Charlas con la industria', texto: 'Profesionales de AWS y de la comunidad tech cuentan cómo trabajan.', color: 'var(--color-morado)' },
  { icono: 'certificado', titulo: 'Study jams', texto: 'Sesiones en grupo para preparar tu primera certificación de AWS.', color: 'var(--color-azul)' },
  { icono: 'rayo', titulo: 'Build days', texto: 'Retos en equipo para crear un proyecto completo en un solo día.', color: 'var(--color-menta)' },
] as const;
---
<Layout titulo="Eventos" descripcion="Talleres, charlas y eventos de AWS SBG UNISTMO en el Campus Tehuantepec.">
  <CabeceraPagina
    etiqueta="// Eventos"
    titulo="Talleres, charlas y mucho cloud"
    resaltar={['cloud']}
    descripcion="Todos nuestros eventos se publican en Meetup y aparecen aquí automáticamente. Regístrate ahí para apartar tu lugar."
    pose="12-audifonos"
  />

  <section class="mx-auto max-w-7xl px-5">
    <h2 class="titulo text-2xl font-semibold" data-reveal>Próximos</h2>
    {proximos.length > 0 ? (
      <div class="mt-8 grid gap-6 lg:grid-cols-2" data-stagger>
        {proximos.map((e) => <EventoTarjeta evento={e} />)}
      </div>
    ) : (
      <div class="tarjeta mt-8 p-8" data-reveal>
        <p class="leading-relaxed">
          Todavía no hay eventos publicados. Síguenos en Meetup para recibir el aviso en cuanto abramos el registro.
        </p>
        <a href={site.meetup} target="_blank" rel="noopener" class="boton boton-primario mt-6" data-magnetico>
          Ir al Meetup <Icono nombre="externo" class="size-4" />
        </a>
      </div>
    )}

    <h2 class="titulo mt-20 text-2xl font-semibold" data-reveal>Lo que organizamos</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {tipos.map((t) => (
        <article class="tarjeta p-6" data-tilt style={`--acento:${t.color}`}>
          <span class="grid size-11 place-items-center rounded-xl" style="background:color-mix(in srgb,var(--acento) 15%,transparent);color:var(--acento)">
            <Icono nombre={t.icono} class="size-5" />
          </span>
          <h3 class="titulo mt-5 text-lg font-semibold">{t.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed">{t.texto}</p>
        </article>
      ))}
    </div>

    {pasados.length > 0 && (
      <>
        <h2 class="titulo mt-20 text-2xl font-semibold" data-reveal>Anteriores</h2>
        <div class="mt-8 grid gap-6 lg:grid-cols-2" data-stagger>
          {pasados.map((e) => <EventoTarjeta evento={e} pasado />)}
        </div>
      </>
    )}
  </section>
</Layout>
