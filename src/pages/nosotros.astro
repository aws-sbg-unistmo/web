---
import Layout from '../layouts/Layout.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import SubNav from '../components/SubNav.astro';
import Icono from '../components/Icono.astro';
import Palabras from '../components/Palabras.astro';
import Universidad from '../components/Universidad.astro';
import Alianzas from '../components/Alianzas.astro';
import Equipo from '../components/Equipo.astro';
import { site } from '../data/site';

const valores = [
  { t: 'Aprender haciendo', d: 'Cada taller termina con algo construido por ti, no con diapositivas.' },
  { t: 'Compartir lo que sabes', d: 'Quien aprende algo, lo enseña. Así crecemos todos más rápido.' },
  { t: 'Abiertos a todos', d: 'Sin importar tu carrera, semestre o experiencia previa.' },
  { t: 'Del Istmo al mundo', d: 'Conectamos a la UNISTMO con la comunidad global de AWS.' },
];
const pilares = [
  { icono: 'libro', t: 'Aprender', d: 'Talleres, sesiones de estudio y acceso a recursos de aprendizaje de AWS.', c: 'var(--color-magenta)' },
  { icono: 'proyecto', t: 'Construir', d: 'Proyectos reales en equipo con servicios de AWS, de la idea a producción.', c: 'var(--color-morado)' },
  { icono: 'usuarios', t: 'Conectar', d: 'Charlas con profesionales y una red de grupos estudiantiles en todo el mundo.', c: 'var(--color-azul)' },
] as const;
const historia = [
  {
    cuando: 'Septiembre 2026',
    titulo: 'Nos unimos a AWS Student Builder Groups',
    texto: 'La UNISTMO, Campus Tehuantepec, entra al programa global de AWS y nace nuestro grupo en Meetup: el primero del programa en Oaxaca.',
  },
  {
    cuando: 'Octubre 2026',
    titulo: 'Lanzamos redes y esta página',
    texto: 'Abrimos Instagram, TikTok, Facebook, YouTube y LinkedIn, y construimos esta web con servicios de AWS.',
  },
  {
    cuando: 'Muy pronto',
    titulo: 'Nuestro primer evento en el campus',
    texto: 'Presentación del grupo e introducción a AWS. Únete al Meetup para enterarte de la fecha.',
    futuro: true,
  },
];
const codigo = [
  { t: 'Respeto para todas las personas', d: 'Sin importar carrera, nivel, género, origen o forma de pensar.' },
  { t: 'Cero acoso', d: 'No toleramos acoso, discriminación ni comentarios ofensivos, en persona ni en línea.' },
  { t: 'Preguntar está bien', d: 'No hay preguntas tontas. Ayudamos con paciencia a quien va empezando.' },
  { t: 'Cuida las cuentas', d: 'Nunca compartas contraseñas ni llaves de acceso, y apaga lo que no uses para evitar cobros.' },
  { t: 'Da crédito', d: 'Si usas el código, las ideas o el trabajo de alguien más, menciónalo.' },
];
---
<Layout titulo="Nosotros" precargar="/img/cabecera-nosotros.jpg" descripcion="Quiénes somos: el AWS Student Builder Group de la Universidad del Istmo, Campus Tehuantepec.">
  <CabeceraPagina
    migas="Nosotros"
    etiqueta="// Nosotros"
    titulo="Una comunidad de estudiantes que construye"
    resaltar={['construye']}
    descripcion="Somos el AWS Student Builder Group de la Universidad del Istmo, Campus Tehuantepec: un grupo dirigido por estudiantes para aprender cloud computing e inteligencia artificial con AWS."
    pose="10-pensando"
    video="nosotros"
  />

  <SubNav
    titulo="Nosotros"
    enlaces={[
      { id: 'mision', texto: 'Quiénes somos' },
      { id: 'programa', texto: 'El programa' },
      { id: 'universidad', texto: 'Universidad' },
      { id: 'historia', texto: 'Historia' },
      { id: 'equipo', texto: 'Equipo' },
      { id: 'alianzas', texto: 'Alianzas' },
      { id: 'codigo', texto: 'Código de conducta' },
    ]}
  />

  <section id="mision" class="mx-auto grid max-w-7xl gap-6 px-5 pt-20 md:grid-cols-2" data-stagger data-carrusel>
    <article class="tarjeta p-8" data-tilt>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-magenta">Misión</p>
      <p class="titulo mt-4 text-2xl font-semibold leading-snug">
        Que cualquier estudiante del Istmo pueda dar sus primeros pasos en la nube con acompañamiento y en comunidad.
      </p>
    </article>
    <article class="tarjeta p-8" data-tilt>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-morado">Visión</p>
      <p class="titulo mt-4 text-2xl font-semibold leading-snug">
        Ser la comunidad tech estudiantil de referencia en Oaxaca, formando builders que crean soluciones reales.
      </p>
    </article>
  </section>

  <!-- Qué es un Student Builder Group -->
  <section id="programa" class="mx-auto mt-28 max-w-7xl px-5">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-end">
      <div>
        <p class="chip" data-reveal>// El programa</p>
        <Palabras texto="¿Qué es un AWS Student Builder Group?" resaltar={['Student', 'Builder', 'Group?']} class="mt-5 text-4xl font-bold leading-tight md:text-5xl" />
      </div>
      <div data-reveal>
        <p class="text-lg leading-relaxed">
          Es una comunidad <strong class="font-semibold text-white">dirigida por estudiantes</strong>, con apoyo de Amazon Web Services,
          para aprender tecnologías de la nube, construir proyectos y conectar con la industria. Hay grupos en más de 600
          universidades de más de 60 países, y el nuestro es el de la UNISTMO, Campus Tehuantepec.
        </p>
        <a href="https://builder.aws.com/community/student-builder-groups" target="_blank" rel="noopener" class="enlace-aws mt-6">
          Conoce el programa en AWS Builder Center <Icono nombre="externo" class="size-4" />
        </a>
      </div>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3" data-stagger data-carrusel>
      {pilares.map((p) => (
        <article class="tarjeta p-7" data-tilt style={`--acento:${p.c}`}>
          <span class="grid size-12 place-items-center rounded-xl" style="background:color-mix(in srgb,var(--acento) 15%,transparent);color:var(--acento)">
            <Icono nombre={p.icono} class="size-6" />
          </span>
          <h3 class="titulo mt-6 text-2xl font-semibold">{p.t}</h3>
          <p class="mt-2 leading-relaxed">{p.d}</p>
        </article>
      ))}
    </div>

    <div class="tarjeta relative mt-6 grid items-center gap-6 overflow-hidden p-7 md:grid-cols-[auto_1fr] md:p-10" data-reveal>
      <div class="absolute -left-20 -top-20 size-64 rounded-full bg-magenta/15 blur-3xl" aria-hidden="true"></div>
      <p class="titulo relative text-7xl font-bold md:text-8xl"><span class="degradado">1°</span></p>
      <div class="relative">
        <h3 class="titulo text-2xl font-semibold md:text-3xl">El primer AWS Student Builder Group de Oaxaca</h3>
        <p class="mt-3 max-w-3xl leading-relaxed">
          En México hay grupos del programa en universidades como la UNAM, el Tec de Monterrey, la UAEMex y la Universidad
          Politécnica de Yucatán. En Oaxaca, el nuestro es el primero: traemos el programa al Istmo para que nadie tenga que
          irse lejos para aprender cloud e IA.
        </p>
        <p class="mt-3 text-xs text-suave/60">Según los grupos publicados en Meetup y AWS Builder Center, octubre de 2026.</p>
      </div>
    </div>
  </section>

  <Universidad />

  <section class="mx-auto mt-28 max-w-7xl px-5">
    <p class="chip" data-reveal>// Lo que nos mueve</p>
    <Palabras texto="Nuestros valores" resaltar={['valores']} class="mt-5 text-4xl font-bold md:text-5xl" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger data-carrusel>
      {valores.map((v, i) => (
        <article class="tarjeta p-7" data-tilt>
          <span class="font-mono text-sm text-magenta">0{i + 1}</span>
          <h3 class="titulo mt-4 text-xl font-semibold">{v.t}</h3>
          <p class="mt-3 text-sm leading-relaxed">{v.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="historia" class="mx-auto mt-28 max-w-4xl px-5">
    <p class="chip" data-reveal>// Nuestra historia</p>
    <Palabras texto="Así empezamos" resaltar={['empezamos']} class="mt-5 text-4xl font-bold md:text-5xl" />
    <div class="relative mt-12 pl-10">
      <span class="absolute bottom-2 left-[11px] top-2 w-0.5 bg-linea" aria-hidden="true"></span>
      <span class="absolute bottom-2 left-[11px] top-2 w-0.5 origin-top bg-gradient-to-b from-magenta via-morado to-azul" data-linea aria-hidden="true"></span>
      <ol class="space-y-12">
        {historia.map((h) => (
          <li class="relative" data-reveal>
            <span class="absolute -left-10 top-1 grid size-6 place-items-center rounded-full border-2 border-magenta bg-marino" aria-hidden="true">
              <span class:list={['size-2 rounded-full', h.futuro ? 'bg-transparent' : 'bg-magenta']}></span>
            </span>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-magenta">{h.cuando}</p>
            <h3 class="titulo mt-2 text-2xl font-semibold">{h.titulo}</h3>
            <p class="mt-2 leading-relaxed">{h.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Equipo />

  <Alianzas />

  <!-- Código de conducta -->
  <section id="codigo" class="mx-auto mt-28 max-w-7xl px-5">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="lg:sticky lg:top-40 lg:self-start">
        <p class="chip" data-reveal>// Código de conducta</p>
        <Palabras texto="Un espacio seguro para aprender" resaltar={['seguro']} class="mt-5 text-4xl font-bold leading-tight md:text-5xl" />
        <p class="mt-5 leading-relaxed" data-reveal>
          Aplica en eventos, talleres, redes y cualquier espacio del grupo. Al participar, aceptas cuidarlo con nosotros.
        </p>
        <div class="mt-8 flex gap-4 rounded-2xl border border-linea bg-marino-2 p-5" data-reveal>
          <Icono nombre="escudo" class="size-6 shrink-0 text-menta" />
          <p class="text-sm leading-relaxed">
            ¿Viste algo que no está bien? Escríbenos a{' '}
            <a href={`mailto:${site.correo}`} class="font-semibold text-white underline underline-offset-4 hover:text-magenta">{site.correo}</a>.
            Lo atendemos con discreción.
          </p>
        </div>
      </div>
      <ol class="space-y-4" data-stagger>
        {codigo.map((c, i) => (
          <li class="tarjeta flex gap-5 p-6">
            <span class="titulo grid size-10 shrink-0 place-items-center rounded-xl bg-magenta/12 font-bold text-magenta">{i + 1}</span>
            <div>
              <h3 class="titulo text-lg font-semibold">{c.t}</h3>
              <p class="mt-1 text-sm leading-relaxed">{c.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
