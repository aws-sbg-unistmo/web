---
import Layout from '../layouts/Layout.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import SubNav from '../components/SubNav.astro';
import Icono from '../components/Icono.astro';
import Palabras from '../components/Palabras.astro';
import Universidad from '../components/Universidad.astro';
import Alianzas from '../components/Alianzas.astro';
import Voluntariado from '../components/Voluntariado.astro';
import LoteriaJaguar from '../components/LoteriaJaguar.astro';
import Equipo from '../components/Equipo.astro';
import Bordado from '../components/Bordado.astro';
import OrillasLaterales from '../components/OrillasLaterales.astro';
import { site } from '../data/site';

const valores = [
  { t: 'Aprender haciendo', d: 'Cada taller termina con algo construido por ti, no con diapositivas.' },
  { t: 'Compartir lo que sabes', d: 'Quien aprende algo, lo enseña. Así crecemos todos más rápido.' },
  { t: 'Abiertos a todos', d: 'Sin importar tu carrera, semestre o experiencia previa.' },
  { t: 'Del Istmo al mundo', d: 'Conectamos a la UNISTMO con la comunidad global de AWS.' },
];
const pilares = [
  { icono: 'libro', t: 'Aprender', d: 'Talleres, sesiones de estudio y acceso a recursos de aprendizaje de AWS.', c: 'var(--color-magenta)' },
  { icono: 'proyecto', t: 'Construir', d: 'Proyectos reales en equipo con servicios de AWS, de la idea a producción.', c: 'var(--color-morado)' },
  { icono: 'usuarios', t: 'Conectar', d: 'Charlas con profesionales y una red de grupos estudiantiles en todo el mundo.', c: 'var(--color-azul)' },
] as const;
const historia = [
  {
    cuando: 'Septiembre 2026',
    titulo: 'Nos unimos a AWS Student Builder Groups',
    texto: 'La UNISTMO, Campus Tehuantepec, entra al programa global de AWS y nace nuestro grupo en Meetup: el primero del programa en Oaxaca.',
  },
  {
    cuando: 'Octubre 2026',
    titulo: 'Lanzamos redes y esta página',
    texto: 'Abrimos Instagram, TikTok, Facebook, YouTube y LinkedIn, y construimos esta web con servicios de AWS.',
  },
  {
    cuando: 'Muy pronto',
    titulo: 'Nuestro primer evento en el campus',
    texto: 'Presentación del grupo e introducción a AWS. Únete al Meetup para enterarte de la fecha.',
    futuro: true,
  },
];
const codigo = [
  { t: 'Respeto para todas las personas', d: 'Sin importar carrera, nivel, género, origen o forma de pensar.', icono: 'corazon', c: 'var(--color-magenta)' },
  { t: 'Cero acoso', d: 'No toleramos acoso, discriminación ni comentarios ofensivos, en persona ni en línea.', icono: 'mano', c: 'var(--color-naranja)' },
  { t: 'Preguntar está bien', d: 'No hay preguntas tontas. Ayudamos con paciencia a quien va empezando.', icono: 'info', c: 'var(--color-azul)' },
  { t: 'Cuida las cuentas', d: 'Nunca compartas contraseñas ni llaves de acceso, y apaga lo que no uses para evitar cobros.', icono: 'escudo', c: 'var(--color-menta)' },
  { t: 'Da crédito', d: 'Si usas el código, las ideas o el trabajo de alguien más, menciónalo.', icono: 'chispa', c: 'var(--color-morado)' },
];
---
<Layout titulo="Nosotros" precargar="/img/cabecera-nosotros.jpg" descripcion="Quiénes somos: el AWS Student Builder Group de la Universidad del Istmo, Campus Tehuantepec.">
  <CabeceraPagina
    migas="Nosotros"
    etiqueta="// Nosotros"
    titulo="Una comunidad de estudiantes que construye"
    resaltar={['construye']}
    descripcion="Somos el AWS Student Builder Group de la Universidad del Istmo, Campus Tehuantepec: un grupo dirigido por estudiantes para aprender cloud computing e inteligencia artificial con AWS."
    pose="10-pensando"
    video="nosotros"
  />

  <SubNav
    titulo="Nosotros"
    enlaces={[
      { id: 'mision', texto: 'Quiénes somos' },
      { id: 'programa', texto: 'El programa' },
      { id: 'universidad', texto: 'Universidad' },
      { id: 'historia', texto: 'Historia' },
      { id: 'equipo', texto: 'Equipo' },
      { id: 'voluntariado', texto: 'Voluntariado' },
      { id: 'mascota', texto: 'Mascota' },
      { id: 'alianzas', texto: 'Alianzas' },
      { id: 'codigo', texto: 'Código de conducta' },
    ]}
  />

  <section id="mision" class="mx-auto grid max-w-7xl gap-6 px-5 pt-20 md:grid-cols-2" data-stagger data-carrusel>
    <article class="tarjeta p-8" data-tilt>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-magenta">Misión</p>
      <p class="titulo mt-4 text-2xl font-semibold leading-snug">
        Que cualquier estudiante del Istmo pueda dar sus primeros pasos en la nube con acompañamiento y en comunidad.
      </p>
    </article>
    <article class="tarjeta p-8" data-tilt>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-morado">Visión</p>
      <p class="titulo mt-4 text-2xl font-semibold leading-snug">
        Ser la comunidad tech estudiantil de referencia en Oaxaca, formando builders que crean soluciones reales.
      </p>
    </article>
  </section>

  <!-- Qué es un Student Builder Group -->
  <section id="programa" class="relative mx-auto mt-28 max-w-7xl px-5">
    <OrillasLaterales />
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-end">
      <div>
        <p class="chip" data-reveal>// El programa</p>
        <Palabras texto="¿Qué es un AWS Student Builder Group?" resaltar={['Student', 'Builder', 'Group?']} class="mt-5 text-4xl font-bold leading-tight md:text-5xl" />
      </div>
      <div data-reveal>
        <p class="text-lg leading-relaxed">
          Es una comunidad <strong class="font-semibold text-white">dirigida por estudiantes</strong>, con apoyo de Amazon Web Services,
          para aprender tecnologías de la nube, construir proyectos y conectar con la industria. Hay grupos en más de 600
          universidades de más de 60 países, y el nuestro es el de la UNISTMO, Campus Tehuantepec.
        </p>
        <dl class="cifras-programa mt-7 grid grid-cols-3 gap-3">
          <div class="cifra rounded-2xl border border-linea bg-marino-2/70 p-4">
            <dd class="titulo text-2xl font-bold md:text-3xl"><span data-contar="600">600</span><span class="text-magenta">+</span></dd>
            <dt class="mt-1 text-xs leading-snug md:text-sm">universidades</dt>
          </div>
          <div class="cifra rounded-2xl border border-linea bg-marino-2/70 p-4">
            <dd class="titulo text-2xl font-bold md:text-3xl"><span data-contar="60">60</span><span class="text-morado">+</span></dd>
            <dt class="mt-1 text-xs leading-snug md:text-sm">países</dt>
          </div>
          <div class="cifra rounded-2xl border border-linea bg-marino-2/70 p-4">
            <dd class="titulo text-2xl font-bold md:text-3xl"><span data-contar="1">1</span><span class="text-naranja">.º</span></dd>
            <dt class="mt-1 text-xs leading-snug md:text-sm">en Oaxaca</dt>
          </div>
        </dl>
        <a href="https://builder.aws.com/community/student-builder-groups" target="_blank" rel="noopener" class="enlace-aws mt-6">
          Conoce el programa en AWS Builder Center <Icono nombre="externo" class="size-4" />
        </a>
      </div>
    </div>
    <ol class="pilares mt-12 grid gap-6 md:grid-cols-3" data-en-vista data-carrusel>
      {pilares.map((p, i) => (
        <li class="pilar relative" style={`--acento:${p.c};--i:${i}`}>
          <article class="pilar-tarjeta tarjeta group relative h-full overflow-hidden p-7 md:p-8" data-tilt>
            <span class="pilar-luz pointer-events-none absolute -right-16 -top-16 size-48 rounded-full blur-3xl" aria-hidden="true"></span>
            <div class="relative flex items-center justify-between">
              <span class="pilar-icono relative grid size-14 place-items-center rounded-2xl">
                <Icono nombre={p.icono} class="size-7" />
                <span class="pilar-orbita absolute -inset-2 rounded-[1.4rem]" aria-hidden="true"></span>
              </span>
              <span class="pilar-paso font-mono text-[0.68rem] uppercase tracking-[0.25em]">Paso 0{i + 1}</span>
            </div>
            <h3 class="titulo relative mt-7 text-3xl font-bold">{p.t}</h3>
            <p class="relative mt-3 leading-relaxed">{p.d}</p>
            <span class="pilar-barra absolute inset-x-0 bottom-0 h-1" aria-hidden="true"></span>
          </article>
          {i < pilares.length - 1 && (
            <span class="pilar-enlace absolute top-1/2 z-10 hidden size-9 -translate-y-1/2 place-items-center rounded-full md:grid" aria-hidden="true">
              <Icono nombre="flecha" class="size-4" />
            </span>
          )}
        </li>
      ))}
    </ol>

    <div class="primero tarjeta relative mt-6 grid items-center gap-8 overflow-hidden p-7 md:grid-cols-[auto_1fr] md:gap-10 md:p-10" data-reveal>
      <div class="absolute -left-20 -top-20 size-64 rounded-full bg-magenta/15 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -bottom-24 right-1/4 size-64 rounded-full bg-naranja/10 blur-3xl" aria-hidden="true"></div>
      <Bordado tipo="orilla" lado="der" class="-right-6 top-1/2 hidden h-[150%] -translate-y-1/2 opacity-25 lg:block" />
      <div class="medalla relative mx-auto grid size-44 place-items-center md:size-52" aria-hidden="true">
        <svg viewBox="0 0 200 200" class="medalla-texto absolute inset-0 size-full">
          <defs><path id="circulo-primero" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0" /></defs>
          <text><textPath href="#circulo-primero">PRIMER GRUPO EN OAXACA · ISTMO DE TEHUANTEPEC · </textPath></text>
        </svg>
        <span class="medalla-aro absolute inset-[2.1rem] rounded-full md:inset-[2.4rem]"></span>
        <p class="titulo relative text-6xl font-bold md:text-7xl"><span class="degradado">1°</span></p>
      </div>
      <div class="relative">
        <h3 class="titulo text-2xl font-semibold md:text-3xl">El primer AWS Student Builder Group de Oaxaca</h3>
        <p class="mt-3 max-w-3xl leading-relaxed">
          En México hay grupos del programa en universidades como la UNAM, el Tec de Monterrey, la UAEMex y la Universidad
          Politécnica de Yucatán. En Oaxaca, el nuestro es el primero: traemos el programa al Istmo para que nadie tenga que
          irse lejos para aprender cloud e IA.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2 text-xs">
          {['UNAM', 'Tec de Monterrey', 'UAEMex', 'UP Yucatán'].map((u) => <li class="rounded-full border border-linea bg-marino/60 px-3 py-1.5">{u}</li>)}
          <li class="grupo-nuestro inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 font-semibold text-white"><Icono nombre="lugar" class="size-3.5" />UNISTMO · Oaxaca</li>
        </ul>
        <p class="mt-4 text-xs text-suave/60">Según los grupos publicados en Meetup y AWS Builder Center, octubre de 2026.</p>
      </div>
    </div>
  </section>

  <Universidad />

  <section class="mx-auto mt-28 max-w-7xl px-5">
    <p class="chip" data-reveal>// Lo que nos mueve</p>
    <Palabras texto="Nuestros valores" resaltar={['valores']} class="mt-5 text-4xl font-bold md:text-5xl" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger data-carrusel>
      {valores.map((v, i) => (
        <article class="tarjeta p-7" data-tilt>
          <span class="font-mono text-sm text-magenta">0{i + 1}</span>
          <h3 class="titulo mt-4 text-xl font-semibold">{v.t}</h3>
          <p class="mt-3 text-sm leading-relaxed">{v.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="historia" class="mx-auto mt-28 max-w-4xl px-5">
    <p class="chip" data-reveal>// Nuestra historia</p>
    <Palabras texto="Así empezamos" resaltar={['empezamos']} class="mt-5 text-4xl font-bold md:text-5xl" />
    <div class="relative mt-12 pl-10">
      <span class="absolute bottom-2 left-[11px] top-2 w-0.5 bg-linea" aria-hidden="true"></span>
      <span class="absolute bottom-2 left-[11px] top-2 w-0.5 origin-top bg-gradient-to-b from-magenta via-morado to-azul" data-linea aria-hidden="true"></span>
      <ol class="space-y-12">
        {historia.map((h) => (
          <li class="relative" data-reveal>
            <span class="absolute -left-10 top-1 grid size-6 place-items-center rounded-full border-2 border-magenta bg-marino" aria-hidden="true">
              <span class:list={['size-2 rounded-full', h.futuro ? 'bg-transparent' : 'bg-magenta']}></span>
            </span>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-magenta">{h.cuando}</p>
            <h3 class="titulo mt-2 text-2xl font-semibold">{h.titulo}</h3>
            <p class="mt-2 leading-relaxed">{h.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Equipo />

  <Voluntariado />

  <LoteriaJaguar />

  <Alianzas />

  <!-- Código de conducta -->
  <section id="codigo" class="relative mx-auto mt-28 max-w-7xl px-5">
    <OrillasLaterales />
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="lg:sticky lg:top-40 lg:self-start">
        <p class="chip" data-reveal>// Código de conducta</p>
        <Palabras texto="Un espacio seguro para aprender" resaltar={['seguro']} class="mt-5 text-4xl font-bold leading-tight md:text-5xl" />
        <p class="mt-5 leading-relaxed" data-reveal>
          Aplica en eventos, talleres, redes y cualquier espacio del grupo. Al participar, aceptas cuidarlo con nosotros.
        </p>
        <div class="aviso-codigo relative mt-8 flex gap-4 overflow-hidden rounded-2xl border border-menta/30 bg-marino-2 p-5" data-reveal>
          <span class="pointer-events-none absolute -left-10 -top-10 size-32 rounded-full bg-menta/15 blur-2xl" aria-hidden="true"></span>
          <span class="relative grid size-10 shrink-0 place-items-center rounded-xl bg-menta/15 text-menta"><Icono nombre="escudo" class="size-5" /></span>
          <p class="relative text-sm leading-relaxed">
            ¿Viste algo que no está bien? Escríbenos a{' '}
            <a href={`mailto:${site.correo}`} class="font-semibold text-white underline underline-offset-4 hover:text-magenta">{site.correo}</a>.
            Lo atendemos con discreción.
          </p>
        </div>
        {site.usarMascota && (
          <div class="guardian relative mx-auto mt-10 hidden w-fit lg:block" data-reveal>
            <span class="guardian-escudo absolute left-1/2 top-[55%] size-60 -translate-x-1/2 -translate-y-1/2 rounded-full" aria-hidden="true"></span>
            <img src="/img/mascota/20-seguridad.webp" alt="" width="622" height="900" loading="lazy" class="relative h-64 w-auto drop-shadow-[0_20px_40px_rgba(0,0,0,0.5)]" />
          </div>
        )}
      </div>
      <ol class="acuerdos tcs space-y-4" data-en-vista>
        {codigo.map((c, i) => (
          <li class="acuerdo tc tarjeta relative flex items-center gap-5 overflow-hidden p-6 pr-24 md:pr-28" style={`--c:${c.c};--i:${i}`}>
            <span class="tc-luz pointer-events-none absolute -left-12 -top-12 size-36 rounded-full blur-3xl" aria-hidden="true"></span>
            <span class="tc-num titulo pointer-events-none absolute -bottom-8 left-3 select-none text-7xl font-bold" aria-hidden="true">{i + 1}</span>
            <span class="tc-icono relative grid size-12 shrink-0 place-items-center rounded-2xl"><Icono nombre={c.icono} class="size-6" /></span>
            <div class="relative">
              <h3 class="titulo text-lg font-semibold">{c.t}</h3>
              <p class="mt-1 text-sm leading-relaxed">{c.d}</p>
            </div>
            <span class="sello absolute right-4 top-1/2 grid size-16 -translate-y-1/2 place-items-center rounded-full text-center font-mono text-[0.55rem] font-bold uppercase leading-tight tracking-wider md:right-6 md:size-[4.5rem]" aria-hidden="true">
              <span><Icono nombre="check" class="mx-auto size-5" />Acuerdo</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

<style>
  /* El programa: tres pasos que se encienden en orden y se conectan con flechas */
  .pilar-tarjeta { transition: border-color 0.4s ease, translate 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease; }
  .pilar-tarjeta:hover { border-color: color-mix(in srgb, var(--acento) 55%, transparent); translate: 0 -6px; box-shadow: 0 30px 60px -34px var(--acento); }
  .pilar-luz { background: var(--acento); opacity: 0.12; transition: opacity 0.5s ease, scale 0.6s ease; }
  .pilar-tarjeta:hover .pilar-luz { opacity: 0.28; scale: 1.3; }
  .pilar-icono { background: color-mix(in srgb, var(--acento) 16%, transparent); color: var(--acento); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--acento) 35%, transparent); transition: rotate 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .pilar-tarjeta:hover .pilar-icono { rotate: -8deg; scale: 1.08; }
  .pilar-orbita { border: 1px dashed color-mix(in srgb, var(--acento) 45%, transparent); animation: orbita-pilar 14s linear infinite; }
  @keyframes orbita-pilar { to { rotate: 360deg; } }
  .pilar-paso { color: var(--acento); }
  .pilar-barra { background: linear-gradient(90deg, var(--acento), transparent); transform-origin: left; }
  /* Cada paso queda encima del siguiente para que su flecha no se esconda; la flecha va centrada en el hueco */
  .pilar { z-index: calc(5 - var(--i)); }
  .pilar-enlace { right: calc(-0.75rem - 1.125rem); background: var(--color-marino); color: var(--color-suave); box-shadow: inset 0 0 0 1px var(--color-linea), 0 0 0 5px var(--color-marino); }
  .pilares.preparado:not(.en-vista) .pilar { opacity: 0; }
  .pilares.en-vista .pilar { animation: sube-pilar 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i) * 0.22s); }
  .pilares.en-vista .pilar-icono { animation: salta-icono 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(0.25s + var(--i) * 0.22s); }
  .pilares.en-vista .pilar-barra { animation: barra-pilar 1s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(0.35s + var(--i) * 0.22s); }
  .pilares.en-vista .pilar-enlace { animation: enlace-pilar 2.4s ease-in-out infinite; animation-delay: calc(0.9s + var(--i) * 0.3s); }
  @keyframes sube-pilar { from { opacity: 0; transform: translateY(36px); } }
  @keyframes salta-icono { from { scale: 0.4; rotate: -30deg; } }
  @keyframes barra-pilar { from { transform: scaleX(0); } }
  @keyframes enlace-pilar {
    0%, 100% { color: var(--color-suave); box-shadow: inset 0 0 0 1px var(--color-linea); translate: 0 -50%; }
    50% { color: var(--color-marino); background: var(--acento); box-shadow: 0 0 22px var(--acento); translate: 4px -50%; }
  }
  .cifra { transition: border-color 0.3s ease, translate 0.3s ease; }
  .cifra:hover { border-color: color-mix(in srgb, var(--color-magenta) 45%, transparent); translate: 0 -3px; }

  /* Medalla del «1°»: texto que gira alrededor y un aro de colores */
  .medalla-texto { animation: gira-medalla 22s linear infinite; }
  .medalla-texto text { fill: var(--color-suave); font: 600 12.5px ui-monospace, monospace; letter-spacing: 3.1px; }
  .medalla-aro { background: conic-gradient(from 0deg, var(--color-magenta), var(--color-morado), var(--color-azul), var(--color-naranja), var(--color-magenta)); animation: gira-medalla 7s linear infinite reverse; filter: drop-shadow(0 0 18px color-mix(in srgb, var(--color-magenta) 50%, transparent)); }
  .medalla-aro::after { content: ''; position: absolute; inset: 3px; border-radius: inherit; background: var(--color-marino-2); }
  @keyframes gira-medalla { to { rotate: 360deg; } }
  .grupo-nuestro { background: linear-gradient(90deg, var(--color-magenta), var(--color-morado)); box-shadow: 0 0 20px -4px var(--color-magenta); }
  @media (prefers-reduced-motion: reduce) {
    .medalla-texto, .medalla-aro, .pilar-orbita { animation: none; }
  }
</style>

<style>
  .tc { transition: border-color 0.4s ease, translate 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease; }
  .tc:hover { border-color: color-mix(in srgb, var(--c) 55%, transparent); translate: 0 -6px; box-shadow: 0 28px 56px -34px var(--c); }
  .tc-luz { background: var(--c); opacity: 0.1; transition: opacity 0.4s ease, scale 0.6s ease; }
  .tc:hover .tc-luz { opacity: 0.28; scale: 1.25; }
  .tc-icono { background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 35%, transparent); transition: rotate 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), scale 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .tc:hover .tc-icono { rotate: -10deg; scale: 1.1; }
  .tc-num { color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, var(--c) 35%, transparent); transition: -webkit-text-stroke-color 0.4s ease; }
  .tc:hover .tc-num { -webkit-text-stroke-color: var(--c); }
  .tc-linea { background: linear-gradient(90deg, var(--c), transparent); transform: scaleX(0.25); transform-origin: left; transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .tc:hover .tc-linea { transform: scaleX(1); }
  .tcs.preparado:not(.en-vista) .tc { opacity: 0; }
  .tcs.en-vista .tc { animation: entra-tc 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(var(--i) * 0.12s); }
  @keyframes entra-tc { from { opacity: 0; transform: translateY(32px); } }

  /* Código de conducta: cada acuerdo recibe su sello al aparecer */
  .sello { color: var(--c); border: 2px dashed color-mix(in srgb, var(--c) 70%, transparent); background: color-mix(in srgb, var(--c) 8%, transparent); rotate: -12deg; }
  .acuerdos.preparado:not(.en-vista) .sello { opacity: 0; }
