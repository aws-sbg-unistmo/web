---
// Cuadro de color por categoría con un glifo blanco, al estilo de los iconos de arquitectura de AWS.
// No usa los iconos oficiales: solo la idea visual (color por categoría + forma).
import Icono from './Icono.astro';
import { categorias, type Categoria } from '../data/contenido';

interface Props {
  categoria: Categoria;
  icono?: Parameters<typeof Icono>[0]['nombre'];
  tam?: 'sm' | 'md' | 'lg';
}
const { categoria, icono, tam = 'md' } = Astro.props;
const cat = categorias[categoria];
const medidas = { sm: 'size-9 rounded-lg', md: 'size-12 rounded-xl', lg: 'size-16 rounded-2xl' }[tam];
const glifo = { sm: 'size-5', md: 'size-6', lg: 'size-8' }[tam];
---
<span
  class:list={['mosaico grid shrink-0 place-items-center text-white', medidas]}
  style={`--cat:${cat.color}`}
  title={cat.nombre}
>
  <Icono nombre={(icono ?? cat.icono) as any} class={glifo} />
</span>

<style>
  .mosaico {
    background: linear-gradient(140deg, color-mix(in srgb, var(--cat) 80%, #000) 0%, var(--cat) 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18), 0 10px 24px -12px var(--cat);
  }
</style>
