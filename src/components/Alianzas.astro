---
// Alianzas: muestra a los aliados de src/data/site.ts (alianzas) y cómo sumarse.
// Mientras la lista esté vacía, solo aparece la invitación.
import Icono from './Icono.astro';
import Palabras from './Palabras.astro';
import { alianzas } from '../data/site';

const tipos = [
  { icono: 'usuarios', t: 'Comunidades tech', d: 'Organizamos eventos en conjunto y compartimos ponentes y difusión.', c: 'var(--color-magenta)' },
  { icono: 'proyecto', t: 'Empresas', d: 'Charlas, mentorías y retos que acercan a los estudiantes a la industria.', c: 'var(--color-morado)' },
  { icono: 'libro', t: 'Instituciones educativas', d: 'Intercambio con otras universidades y grupos estudiantiles.', c: 'var(--color-azul)' },
  { icono: 'microfono', t: 'Medios y creadores', d: 'Difusión de eventos y contenido de tecnología para la región.', c: 'var(--color-menta)' },
] as const;
const iniciales = (n: string) => n.split(' ').filter(Boolean).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
---
<section id="alianzas" class="mx-auto mt-28 max-w-7xl px-5">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-2xl">
      <p class="chip" data-reveal>// Alianzas</p>
      <Palabras texto="Construimos junto a otras comunidades" resaltar={['comunidades']} class="mt-5 text-4xl font-bold leading-tight md:text-5xl" />
    </div>
    <a href="/contacto/?motivo=alianza" class="boton boton-primario" data-reveal data-magnetico>Quiero ser aliado <Icono nombre="flecha" class="size-5" /></a>
  </div>

  {alianzas.length > 0 ? (
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {alianzas.map((a) => (
        <li>
          {a.url ? (
            <a href={a.url} target="_blank" rel="noopener" class="tarjeta group flex h-full items-start gap-5 p-6" data-tilt>
              {a.logo ? <img src={a.logo} alt="" width="64" height="64" loading="lazy" class="size-16 shrink-0 rounded-2xl bg-white object-contain p-2" /> : <span class="titulo grid size-16 shrink-0 place-items-center rounded-2xl bg-linea text-xl font-bold text-white">{iniciales(a.nombre)}</span>}
              <span>
                <span class="insignia" style="--color-insignia:var(--color-azul)">{a.tipo}</span>
                <span class="titulo mt-2 flex items-center gap-1.5 text-lg font-semibold group-hover:text-magenta">{a.nombre} <Icono nombre="externo" class="size-4" /></span>
                <span class="mt-1 block text-sm leading-relaxed">{a.texto}</span>
              </span>
            </a>
          ) : (
            <div class="tarjeta flex h-full items-start gap-5 p-6">
              {a.logo ? <img src={a.logo} alt="" width="64" height="64" loading="lazy" class="size-16 shrink-0 rounded-2xl bg-white object-contain p-2" /> : <span class="titulo grid size-16 shrink-0 place-items-center rounded-2xl bg-linea text-xl font-bold text-white">{iniciales(a.nombre)}</span>}
              <span>
                <span class="insignia" style="--color-insignia:var(--color-azul)">{a.tipo}</span>
                <span class="titulo mt-2 block text-lg font-semibold">{a.nombre}</span>
                <span class="mt-1 block text-sm leading-relaxed">{a.texto}</span>
              </span>
            </div>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-8 max-w-3xl text-lg leading-relaxed" data-reveal>
      Estamos formando nuestras primeras alianzas. Si tu comunidad, empresa o escuela quiere acercar la tecnología a los
      estudiantes del Istmo, escríbenos: aquí aparecerán quienes construyan con nosotros.
    </p>
  )}

  <div class="mt-10 grid gap-px overflow-hidden rounded-3xl border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-4" data-stagger>
    {tipos.map((t) => (
      <article class="bg-marino-2 p-7 transition-colors hover:bg-[#222c38]" style={`--acento:${t.c}`}>
        <span class="grid size-11 place-items-center rounded-xl" style="background:color-mix(in srgb,var(--acento) 15%,transparent);color:var(--acento)"><Icono nombre={t.icono} class="size-5" /></span>
        <h3 class="titulo mt-5 text-lg font-semibold">{t.t}</h3>
        <p class="mt-2 text-sm leading-relaxed">{t.d}</p>
      </article>
    ))}
  </div>
</section>
