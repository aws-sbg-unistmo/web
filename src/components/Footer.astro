---
import Icono from './Icono.astro';
import { navegacion, redes, site } from '../data/site';
const anio = new Date().getFullYear();
---
<footer class="relative mt-32 overflow-hidden border-t border-linea">
  <div class="pointer-events-none absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-magenta to-transparent"></div>
  <div class="pointer-events-none absolute -bottom-40 left-1/2 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-magenta/10 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href="/" class="flex items-center gap-3">
        <img src="/img/logo-192.png" alt="" width="48" height="48" class="size-12 rounded-xl ring-1 ring-white/15" loading="lazy" />
        <span class="titulo text-xl font-semibold">AWS SBG <span class="text-magenta">UNISTMO</span></span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed">{site.descripcion}</p>
      <a href={`mailto:${site.correo}`} class="mt-4 inline-flex items-center gap-2 text-sm text-white hover:text-magenta">
        <Icono nombre="correo" class="size-4" /> {site.correo}
      </a>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-magenta">Página</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {navegacion.map((item) => <li><a href={item.url} class="hover:text-white">{item.texto}</a></li>)}
        <li><a href="/privacidad/" class="hover:text-white">Aviso de privacidad</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-magenta">Síguenos</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {redes.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener" class="group inline-flex items-center gap-2 hover:text-white">
              {r.nombre}
              <Icono nombre="externo" class="size-3.5 opacity-0 transition-opacity group-hover:opacity-100" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="relative border-t border-linea">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-5 py-6 text-xs text-suave/70 md:flex-row md:items-center md:justify-between">
      <p>© {anio} {site.nombre}. Comunidad dirigida por estudiantes.</p>
      <p>
        No es un sitio oficial de Amazon Web Services. AWS y el logotipo de AWS son marcas de Amazon.com, Inc. o sus filiales.
      </p>
    </div>
  </div>
</footer>
