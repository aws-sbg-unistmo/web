---
// Iconos de trazo simple (estilo lineal). Se dibujan en línea para no cargar archivos extra.
interface Props {
  nombre: keyof typeof trazos;
  class?: string;
}
const { nombre, class: clase = 'size-6' } = Astro.props;

const trazos = {
