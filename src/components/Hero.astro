---
import Icono from './Icono.astro';
import Palabras from './Palabras.astro';
import { site } from '../data/site';
---
<section id="portada" class="relative isolate flex min-h-[100svh] items-center overflow-hidden">
  {site.usarMascota && (
    <video
      id="video-portada"
      class="absolute inset-0 -z-30 size-full object-cover object-[72%_center] max-md:object-[96%_center] max-md:opacity-45"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/img/portada.jpg"
      aria-hidden="true"
    >
      <source src="/video/portada-1280.webm" type="video/webm" />
      <source src="/video/portada-1280.mp4" type="video/mp4" />
    </video>
  )}

  <!-- Capas para que el texto se lea sobre el video -->
  <div class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_at_70%_20%,color-mix(in_srgb,var(--color-morado)_25%,transparent),transparent_60%)]"></div>
  <div class="absolute inset-0 -z-20 bg-gradient-to-r from-marino via-marino/75 to-marino/0 max-md:bg-gradient-to-t max-md:via-marino/85"></div>
  <div class="absolute inset-x-0 bottom-0 -z-20 h-56 bg-gradient-to-t from-marino to-transparent"></div>
  <div class="rejilla absolute inset-0 -z-20 opacity-25 [mask-image:radial-gradient(ellipse_at_30%_60%,#000,transparent_70%)]"></div>
  <canvas id="red-portada" class="absolute inset-0 -z-10 size-full opacity-60" aria-hidden="true"></canvas>

  <div class="mx-auto w-full max-w-7xl px-5 pb-24 pt-32">
    <div class="max-w-2xl">
      <p class="chip entrada">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-menta opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-menta"></span>
        </span>
        AWS Student Builder Group
      </p>

      <Palabras
        como="h1"
        texto="Construye en la nube desde el Istmo"
        resaltar={['nube']}
        inmediato
        class="mt-6 text-5xl font-bold leading-[1.02] sm:text-6xl lg:text-7xl"
      />

      <p class="entrada mt-6 max-w-xl text-lg leading-relaxed" style="--d:0.25s">
        La comunidad estudiantil de AWS en la <strong class="font-semibold text-white">UNISTMO, Campus Tehuantepec</strong>.
        Aprende cloud e inteligencia artificial con talleres, eventos y proyectos reales.
      </p>

      <div class="entrada mt-10 flex flex-wrap gap-4" style="--d:0.35s">
        <a href={site.meetup} target="_blank" rel="noopener" class="boton boton-primario" data-magnetico>
          Únete en Meetup <Icono nombre="flecha" class="size-5" />
        </a>
        <a href="/eventos/" class="boton boton-secundario" data-magnetico>Ver eventos</a>
      </div>
      <p class="entrada mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-suave/80" style="--d:0.45s">
        <span class="inline-flex items-center gap-1.5"><span class="text-menta">✓</span> Gratis</span>
        <span class="inline-flex items-center gap-1.5"><span class="text-menta">✓</span> Sin experiencia previa</span>
        <span class="inline-flex items-center gap-1.5"><span class="text-menta">✓</span> Para todas las carreras</span>
      </p>

      <div class="entrada mt-10 inline-flex items-center gap-3 rounded-xl border border-linea bg-marino/70 px-4 py-3 font-mono text-sm backdrop-blur" style="--d:0.55s">
        <span class="text-menta">~/unistmo</span>
        <span class="text-magenta">$</span>
        <span id="escritura" class="text-white"></span><span class="cursor-terminal -ml-2 text-magenta">▍</span>
      </div>
    </div>
  </div>

  <a href="#que-hacemos" class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs uppercase tracking-[0.3em] text-suave/70 md:flex" aria-label="Explora: bajar a la siguiente sección">
    Explora
    <span class="flex h-10 w-6 justify-center rounded-full border border-suave/40 pt-2">
      <span class="rueda h-2 w-1 rounded-full bg-magenta"></span>
    </span>
  </a>
</section>

<style>
  /* Intro cinematográfica: el video entra con un ligero zoom hacia atrás */
  #video-portada { transform: scale(1.06); transition: transform 2.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
  #video-portada.listo { transform: scale(1); }
  /* En pantallas más anchas que 16:9 el video ocupa todo el alto (el jaguar se ve completo),
     se ancla a la derecha y su borde izquierdo se funde con el fondo */
  @media (min-aspect-ratio: 16/9) {
    #video-portada {
      left: auto;
      right: 0;
      width: auto;
      max-width: none;
      height: 100%;
      object-fit: cover;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 30%);
      mask-image: linear-gradient(to right, transparent, #000 30%);
    }
  }
  .cursor-terminal { animation: parpadeo 1s steps(1) infinite; }
  @keyframes parpadeo { 50% { opacity: 0; } }
  .rueda { animation: rueda 1.8s ease-in-out infinite; }
  @keyframes rueda { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }
</style>

<script>
  import { iniciarRed } from '../scripts/red';

  iniciarRed(document.getElementById('red-portada') as HTMLCanvasElement);

  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const video = document.getElementById('video-portada') as HTMLVideoElement | null;
  if (video) {
    if (reducir) {
      video.pause();
    } else if (window.innerWidth * Math.min(window.devicePixelRatio || 1, 2) > 1700) {
      // Pantallas grandes: versión de 1920 px
      video.querySelectorAll('source').forEach((s) => (s.src = s.src.replace('-1280.', '-1920.')));
      video.load();
      video.play().catch(() => {});
    }
    // Aparece suave cuando ya tiene cuadros listos (mientras tanto se ve la imagen de portada)
    video.addEventListener('playing', () => video.classList.add('listo'), { once: true });
  }

  // Terminal que escribe comandos de AWS
  const comandos = [
    'aws s3 mb s3://ideas-del-istmo',
    'sam deploy --guided',
    'aws bedrock list-foundation-models',
    'aws lambda invoke --function-name hola-mundo',
    'npm run build && aws s3 sync dist s3://sbg-unistmo',
  ];
  const destino = document.getElementById('escritura');
  if (destino) {
    if (reducir) {
      destino.textContent = comandos[0];
    } else {
      let i = 0;
      const escribir = async () => {
        const texto = comandos[i % comandos.length];
        for (let n = 1; n <= texto.length; n++) {
          destino.textContent = texto.slice(0, n);
          await new Promise((r) => setTimeout(r, 38 + Math.random() * 50));
        }
        await new Promise((r) => setTimeout(r, 1800));
        for (let n = texto.length; n >= 0; n--) {
          destino.textContent = texto.slice(0, n);
          await new Promise((r) => setTimeout(r, 14));
        }
        i++;
        setTimeout(escribir, 350);
      };
      setTimeout(escribir, 1400);
    }
  }
</script>
