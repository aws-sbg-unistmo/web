---
// Encabezado de las páginas internas: migas de pan, etiqueta, título animado, descripción y el jaguar.
// Con "video", el jaguar aparece en un video en bucle de fondo a la derecha (desde tabletas; en celular no, para no saturar).
import Icono from './Icono.astro';
import Palabras from './Palabras.astro';
import Bordado from './Bordado.astro';
import { site } from '../data/site';

interface Props {
  etiqueta: string;
  titulo: string;
  resaltar?: string[];
  descripcion: string;
  pose?: string;
  /** Video de public/video (sin "-1280.webm"); su póster va en public/img/cabecera-<nombre>.jpg */
  video?: string;
  /** Nombre de la página en las migas de pan (Inicio › Nombre) */
  migas?: string;
}
const { etiqueta, titulo, resaltar = [], descripcion, pose, video, migas } = Astro.props;
// Medidas reales de cada pose (ancho × alto) para que el navegador reserve el espacio exacto
const medidas: Record<string, [number, number]> = {
  '01-saludando': [520, 900], '03-celebrando': [620, 900], '06-nube-brillante': [513, 900], '07-sentado-en-servidor': [565, 900],
  '08-leyendo': [744, 900], '09-lupa': [589, 900], '10-pensando': [384, 900], '12-audifonos': [582, 900],
  '13-programando': [738, 900], '14-pizarra': [768, 900], '15-trofeo': [629, 900], '16-megafono': [628, 900],
  '17-selfie': [602, 900], '18-mochila': [569, 900], '19-dormido': [911, 900], '20-seguridad': [622, 900],
  '21-realidad-virtual': [590, 900], '22-totopo': [564, 900], '23-choca-puno': [443, 900], '24-senalando': [545, 900],
};
const [anchoPose, altoPose] = (pose && medidas[pose]) || [600, 900];
const conVideo = Boolean(video && site.usarMascota);
---
<section class:list={['relative isolate overflow-hidden pb-12 pt-36 md:pb-16 md:pt-40', conVideo && 'md:flex md:min-h-[38rem] md:items-end']}>
  <div class="rejilla absolute inset-0 -z-10 opacity-30 [mask-image:radial-gradient(ellipse_at_top,#000,transparent_70%)]"></div>
  <Bordado tipo="orilla" lado="der" class="-right-20 top-28 -z-10 h-[24rem] opacity-50 md:hidden" />
  <div class="absolute -top-40 left-1/2 -z-10 h-96 w-[56rem] -translate-x-1/2 rounded-full bg-morado/20 blur-3xl"></div>
  <div class="mx-auto grid w-full max-w-7xl items-end gap-10 px-5 md:grid-cols-[1fr_auto]">
    <div class="max-w-3xl">
      {migas && (
        <nav aria-label="Migas de pan" class="entrada mb-6">
          <ol class="flex items-center gap-2 text-sm">
            <li><a href="/" class="text-suave/70 underline-offset-4 hover:text-white hover:underline">Inicio</a></li>
            <li aria-hidden="true" class="text-suave/40"><Icono nombre="chevron" class="size-4" /></li>
            <li><span aria-current="page" class="font-medium text-white">{migas}</span></li>
          </ol>
        </nav>
      )}
      <p class="chip entrada">{etiqueta}</p>
      <Palabras como="h1" texto={titulo} resaltar={resaltar} inmediato class="mt-5 text-[2.6rem] font-bold leading-[1.05] sm:text-5xl md:text-6xl" />
      <p class="entrada mt-6 text-lg leading-relaxed" style="--d:0.3s">{descripcion}</p>

      {/* Solo en tabletas y computadoras: fondo de la cabecera, pegado a la derecha y fundido con el texto */}
      {conVideo && (
        <div class="video-cabecera entrada relative mt-8 hidden aspect-[4/3] overflow-hidden rounded-3xl border border-linea shadow-[0_30px_80px_-30px_rgba(255,87,233,0.45)] md:absolute md:block md:inset-y-0 md:right-0 md:left-auto md:-z-20 md:mt-0 md:aspect-video md:h-full md:w-auto md:max-w-full md:rounded-none md:border-0 md:shadow-none" style="--d:0.4s" aria-hidden="true">
          <video class="video-diferido absolute inset-0 size-full object-cover object-[88%_center] md:object-right" muted loop playsinline preload="none" poster={`/img/cabecera-${video}.jpg`}>
            <source data-src={`/video/${video}-1280.webm`} type="video/webm" />
            <source data-src={`/video/${video}-1280.mp4`} type="video/mp4" />
          </video>
          <div class="absolute inset-0 hidden bg-gradient-to-r from-marino via-marino/50 to-transparent md:block"></div>
          <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-marino/80 to-transparent md:h-40 md:from-marino"></div>
        </div>
      )}
    </div>
    {pose && site.usarMascota && !conVideo && (
      <img src={`/img/mascota/${pose}.webp`} alt="" width={anchoPose} height={altoPose} class="flotar hidden h-64 w-auto drop-shadow-[0_20px_50px_rgba(173,92,255,0.3)] md:block" />
    )}
  </div>
</section>

{conVideo && (
  <script>
    import '../scripts/videos';
  </script>
)}

<style>
  .flotar { animation: flotar 6s ease-in-out infinite; }
  @keyframes flotar { 50% { translate: 0 -12px; } }
</style>
