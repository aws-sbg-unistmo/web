---
import Icono from './Icono.astro';
import LogoRed from './LogoRed.astro';
import Palabras from './Palabras.astro';
import { redes, site } from '../data/site';
---
<section class="relative mx-auto mt-20 max-w-7xl px-5 md:mt-32" data-sin-cta>
  <div class="relative isolate overflow-hidden rounded-[2rem] border border-linea" data-reveal>
    {site.usarMascota && (
      <video
        class="video-diferido absolute inset-0 -z-20 size-full object-cover object-[75%_center] max-md:object-[92%_center] max-md:opacity-35"
        muted
        loop
        playsinline
        preload="none"
        poster="/img/llamado.jpg"
        aria-hidden="true"
      >
        <source data-src="/video/llamado-1280.webm" type="video/webm" />
        <source data-src="/video/llamado-1280.mp4" type="video/mp4" />
      </video>
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-marino via-marino/80 to-marino/10 max-md:via-marino/90"></div>
    <div class="rejilla absolute inset-0 -z-10 opacity-20 [mask-image:linear-gradient(90deg,#000,transparent_70%)]"></div>

    <div class="max-w-xl px-6 py-14 sm:px-8 md:px-14 md:py-28">
      <p class="chip">// Tu siguiente paso</p>
      <Palabras texto="¿Listo para construir en la nube?" resaltar={['construir']} class="mt-5 text-4xl font-bold leading-tight md:text-6xl" />
      <p class="mt-5 text-lg leading-relaxed">
        Únete al grupo en Meetup para enterarte de cada evento. ¿Quieres ayudar a organizar o dar un taller? Escríbenos.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href={site.meetup} target="_blank" rel="noopener" class="boton boton-primario" data-magnetico>
          Únete en Meetup <Icono nombre="flecha" class="size-5" />
        </a>
        <a href="/contacto/?motivo=core-team" class="boton boton-secundario" data-magnetico>Quiero participar</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-2.5 sm:gap-3" aria-label="Nuestras redes sociales" data-redes>
        {redes.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener" aria-label={`${r.nombre} (se abre en otra pestaña)`} data-nombre={r.nombre} class="red-animada block rounded-full">
              <LogoRed red={r.tipo} class="size-10 sm:size-11" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import '../scripts/videos';
</script>
