---
// Diagrama de cómo funciona esta misma página, al estilo de los diagramas de arquitectura de AWS.
// Las líneas tienen un pulso de luz que viaja de un servicio al siguiente.
// Los servicios de AWS llevan el color de su categoría; lo que no es de AWS va en gris.
import Icono from './Icono.astro';
import Mosaico from './Mosaico.astro';
import { categorias, type Categoria } from '../data/contenido';

type Nodo = { icono: Parameters<typeof Icono>[0]['nombre']; nombre: string; rol: string; categoria?: Categoria };
const flujos: { titulo: string; color: string; nodos: Nodo[] }[] = [
  {
    titulo: 'Cuando visitas la página',
    color: 'var(--color-magenta)',
    nodos: [
      { icono: 'usuarios', nombre: 'Tú', rol: 'Abres la página' },
      { icono: 'globo', nombre: 'Amazon CloudFront', rol: 'La entrega rápido y con HTTPS', categoria: 'redes' },
      { icono: 'nube', nombre: 'Amazon S3', rol: 'Guarda los archivos del sitio', categoria: 'almacenamiento' },
    ],
  },
  {
    titulo: 'Cuando llenas un formulario',
    color: 'var(--color-morado)',
    nodos: [
      { icono: 'usuarios', nombre: 'Formulario', rol: 'Únete o contacto' },
      { icono: 'flecha', nombre: 'Amazon API Gateway', rol: 'Recibe tu solicitud', categoria: 'redes' },
      { icono: 'rayo', nombre: 'AWS Lambda', rol: 'Valida y procesa', categoria: 'computo' },
      { icono: 'base', nombre: 'DynamoDB + SES', rol: 'Guarda y nos avisa', categoria: 'bases' },
    ],
  },
  {
    titulo: 'Cada 6 horas, sin que nadie lo toque',
    color: 'var(--color-azul)',
    nodos: [
      { icono: 'evento', nombre: 'Meetup', rol: 'Publicamos un evento' },
      { icono: 'proyecto', nombre: 'GitHub Actions', rol: 'Recompila la página' },
      { icono: 'nube', nombre: 'Amazon S3', rol: 'Sube la versión nueva', categoria: 'almacenamiento' },
    ],
  },
];
---
<div class="min-w-0 space-y-6" data-stagger>
  <ul class="flex flex-wrap gap-x-5 gap-y-2 text-xs" aria-label="Colores por categoría">
    {(['redes', 'almacenamiento', 'computo', 'bases'] as const).map((c) => (
      <li class="inline-flex items-center gap-2"><span class="size-2.5 rounded-sm" style={`background:${categorias[c].color}`}></span>{categorias[c].nombre}</li>
    ))}
  </ul>
  <div class="space-y-6 max-md:space-y-0" data-carrusel>
    {flujos.map((flujo) => (
      <div class="tarjeta p-6 md:p-8" style={`--acento:${flujo.color}`}>
        <p class="font-mono text-xs uppercase tracking-[0.2em]" style="color:var(--acento)">{flujo.titulo}</p>
        <ol class="mt-6 flex items-start md:items-center">
          {flujo.nodos.map((n, i) => (
            <>
              {i > 0 && <li class="conector" aria-hidden="true"><span></span></li>}
              <li class="nodo flex min-w-0 flex-1 flex-col items-center gap-2 text-center md:gap-3 md:rounded-2xl md:border md:border-linea md:bg-marino/70 md:p-4">
                {n.categoria ? (
                  <Mosaico categoria={n.categoria} icono={n.icono} />
                ) : (
                  <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-linea bg-marino-2 text-suave">
                    <Icono nombre={n.icono} class="size-6" />
                  </span>
                )}
                <span>
                  <span class="titulo block text-[11px] font-semibold leading-tight md:text-sm">{n.nombre}</span>
                  <span class="hidden text-xs text-suave/80 md:block">{n.rol}</span>
                </span>
              </li>
            </>
          ))}
        </ol>
      </div>
    ))}
  </div>
</div>

<style>
  /* En celular el conector queda a la altura del centro del icono (48px / 2) */
  .conector {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 2px;
    margin-top: 23px;
    background: var(--color-linea);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .conector { width: 48px; margin-top: 0; align-self: center; }
  }
  .conector span {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, var(--acento), transparent);
    animation: pulso-h 1.6s linear infinite;
  }
  @keyframes pulso-h { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  .nodo { transition: border-color 0.3s ease, transform 0.3s ease; }
  .nodo:hover { border-color: var(--acento); transform: translateY(-2px); }
</style>
