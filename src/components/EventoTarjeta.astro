---
import Icono from './Icono.astro';
import { diaYMes, fechaLarga, hora, type Evento } from '../lib/eventos';

interface Props {
  evento: Evento;
  pasado?: boolean;
}
const { evento, pasado = false } = Astro.props;
const { dia, mes } = diaYMes(evento.inicio);
const mayuscula = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
---
<article class:list={['tarjeta group flex gap-5 overflow-hidden p-6', pasado && 'opacity-70', evento.imagen && 'flex-col sm:flex-row']} data-tilt>
  {evento.imagen && <img src={evento.imagen} alt="" width="320" height="200" loading="lazy" class="-mx-6 -mt-6 aspect-[16/9] w-[calc(100%+3rem)] max-w-none object-cover sm:m-0 sm:aspect-square sm:w-36 sm:rounded-2xl" />}
  <div class="flex w-16 shrink-0 flex-col items-center justify-center rounded-2xl border border-magenta/40 bg-magenta/10 py-3 text-center">
    <span class="titulo text-3xl font-bold leading-none">{dia}</span>
    <span class="mt-1 font-mono text-xs tracking-widest text-magenta">{mes}</span>
  </div>
  <div class="min-w-0 flex-1">
    <h3 class="titulo text-xl font-semibold leading-snug">{evento.titulo}</h3>
    <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <span class="inline-flex items-center gap-1.5"><Icono nombre="reloj" class="size-4 text-magenta" />{mayuscula(fechaLarga(evento.inicio))} · {hora(evento.inicio)}</span>
      {evento.lugar && <span class="inline-flex items-center gap-1.5"><Icono nombre="lugar" class="size-4 text-magenta" />{evento.lugar}</span>}
    </p>
    {evento.descripcion && <p class="mt-3 line-clamp-3 text-sm leading-relaxed whitespace-pre-line">{evento.descripcion}</p>}
    {evento.url && (
      <a href={evento.url} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-magenta">
        {evento.url.includes('meetup.com') ? (pasado ? 'Ver en Meetup' : 'Regístrate en Meetup') : pasado ? 'Ver detalles' : 'Regístrate'}
        <Icono nombre="flecha" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
    )}
  </div>
</article>
